<Window x:Class="StackMeUp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StackMeUp"
        Title="StackMeUp" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ContextMenu x:Key="ItemMenu">
            <MenuItem Header="Aç" Click="Menu_Open" FontWeight="SemiBold"/>
            <MenuItem Header="Önizle" InputGestureText="Boşluk" Click="Menu_Preview" IsEnabled="{Binding IsRealFile}"/>
            <MenuItem Header="Dosya konumunu aç" Click="Menu_Reveal" IsEnabled="{Binding IsRealFile}"/>
            <MenuItem Header="Yolu kopyala" Click="Menu_CopyPath" IsEnabled="{Binding IsRealFile}"/>
            <Separator/>
            <MenuItem Header="Yeniden adlandır…" Click="Menu_Rename" IsEnabled="{Binding IsRealFile}"/>
            <MenuItem Header="Geri Dönüşüm Kutusu'na at" Click="Menu_Recycle" IsEnabled="{Binding IsRealFile}"/>
        </ContextMenu>

        <ContextMenu x:Key="HeaderMenu">
            <MenuItem Header="Ayarlar…" Click="Menu_Settings" FontWeight="SemiBold"/>
            <MenuItem Header="Yenile" Click="Menu_Refresh"/>
            <MenuItem Header="Tümünü kapat" Click="Menu_CollapseAll"/>
            <Separator/>
            <MenuItem Header="Bu yığını bir klasörde topla…" Click="Menu_Gather"/>
        </ContextMenu>

        <!-- Yığın başlığı kutusu -->
        <Style x:Key="HeaderBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource HeaderBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HeaderHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Açılan yığının içindeki dosya -->
        <Style x:Key="ItemTile" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Yatay düzen: aşağı düşen liste satırı (simge + ad) -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:StackItem}">
            <Border Style="{StaticResource ItemTile}" Padding="8,5" Margin="0,1"
                    ToolTip="{Binding Path}" ContextMenu="{StaticResource ItemMenu}"
                    MouseEnter="Item_Enter" MouseLeave="Item_Leave"
                    MouseLeftButtonDown="Item_MouseDown" MouseMove="Item_MouseMove" MouseLeftButtonUp="Item_MouseUp">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="{DynamicResource ItemIconSize}" Height="{DynamicResource ItemIconSize}"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource ItemFontSize}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Dikey düzen: yana açılan şeritteki kutucuk (simge üstte, ad altta) -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:StackItem}">
            <Border Style="{StaticResource ItemTile}" Width="{DynamicResource ItemTileWidth}" Padding="4,8,4,6" Margin="1,0"
                    ToolTip="{Binding Path}" ContextMenu="{StaticResource ItemMenu}"
                    MouseEnter="Item_Enter" MouseLeave="Item_Leave"
                    MouseLeftButtonDown="Item_MouseDown" MouseMove="Item_MouseMove" MouseLeftButtonUp="Item_MouseUp">
                <StackPanel>
                    <Image Source="{Binding Icon}" Width="{DynamicResource ItemIconSize}" Height="{DynamicResource ItemIconSize}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource ItemFontSize}" TextAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="{DynamicResource TileTextHeight}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Yığın kapağı: ilk üç dosya yelpaze gibi açılmış + sayı rozeti -->
        <DataTemplate x:Key="CoverTemplate" DataType="{x:Type local:StackGroup}">
            <Grid Width="{DynamicResource CoverSize}" Height="{DynamicResource CoverSize}">
                <Image Source="{Binding Preview3}" Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                       Visibility="{DynamicResource FanVisibility}" RenderTransformOrigin="0.5,0.85" Opacity="0.85"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <TransformGroup><RotateTransform Angle="-11"/><TranslateTransform X="-5" Y="1"/></TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Image Source="{Binding Preview2}" Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                       Visibility="{DynamicResource FanVisibility}" RenderTransformOrigin="0.5,0.85" Opacity="0.92"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <TransformGroup><RotateTransform Angle="8"/><TranslateTransform X="5" Y="1"/></TransformGroup>
                    </Image.RenderTransform>
                </Image>
                <Image Source="{Binding Cover}" Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45"/>
                    </Image.Effect>
                </Image>
                <!-- "Son eklenenler" yığınında küçük saat işareti -->
                <Border x:Name="RecentMark" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-2,0,0"
                        Background="#E6FFFFFF" CornerRadius="9" Width="18" Height="18" Visibility="Collapsed">
                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#222"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"
                        Background="{DynamicResource AccentBrush}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                        Visibility="{DynamicResource CountVisibility}">
                    <TextBlock Text="{Binding Count}" Foreground="White" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRecent}" Value="True">
                    <Setter TargetName="RecentMark" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- YATAY düzen: başlık kutusu -->
        <DataTemplate x:Key="HHeaderTemplate" DataType="{x:Type local:StackGroup}">
            <Border x:Name="Bd" Style="{StaticResource HeaderBorder}" Width="{DynamicResource HeaderWidth}"
                    Padding="6,12,6,8" Margin="0,0,8,8" ContextMenu="{StaticResource HeaderMenu}"
                    PreviewMouseLeftButtonDown="Header_Down" PreviewMouseMove="Header_Move" PreviewMouseLeftButtonUp="Header_Up">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CoverTemplate}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12.5" FontWeight="SemiBold"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderActiveBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- DİKEY düzen: yataydakiyle aynı kutucuk, yalnızca alt alta dizilir (içerik yana açılır) -->
        <DataTemplate x:Key="VTemplate" DataType="{x:Type local:StackGroup}">
            <Border x:Name="Bd" Style="{StaticResource HeaderBorder}" Width="{DynamicResource HeaderWidth}"
                    Padding="6,12,6,8" Margin="0,0,0,8" ContextMenu="{StaticResource HeaderMenu}"
                    PreviewMouseLeftButtonDown="Header_Down" PreviewMouseMove="Header_Move" PreviewMouseLeftButtonUp="Header_Up">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CoverTemplate}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12.5" FontWeight="SemiBold"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderActiveBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" Focusable="False">
            <StackPanel>
                <!-- Dikey düzen -->
                <ItemsControl x:Name="VList" ItemTemplate="{StaticResource VTemplate}" Focusable="False"/>

                <!-- Yatay düzen: başlıklar soldan sağa, seçilen yığın altta liste olarak düşer -->
                <StackPanel x:Name="HRoot">
                    <ItemsControl x:Name="HList" ItemTemplate="{StaticResource HHeaderTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border x:Name="HBody" Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="6"
                            HorizontalAlignment="Left" Visibility="Collapsed" RenderTransformOrigin="0.2,0">
                        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <ScrollViewer x:Name="HBodyScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl x:Name="HBodyItems" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Dikey düzende tıklanan yığının yanına yatay şerit halinde açılan içerik -->
        <Popup x:Name="SidePopup" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None" Placement="Left">
            <Border x:Name="SideBody" Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="6" Margin="8,0">
                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <ScrollViewer x:Name="SideScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Focusable="False" PreviewMouseWheel="SideScroll_Wheel">
                    <ItemsControl x:Name="SideItems" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</Window>
