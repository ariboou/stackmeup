<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>StackMeUp</AssemblyName>
    <RootNamespace>StackMeUp</RootNamespace>
    <ApplicationIcon>assets\StackMeUp.ico</ApplicationIcon>
    <!-- Yeni sürüm yayınlarken bunu artır; GitHub Release etiketi de "v" + bu sayı olmalı (ör. v1.0.1) -->
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\StackMeUp.ico" />
    <None Remove="assets\StackMeUp-256.png" />
  </ItemGroup>
</Project>
