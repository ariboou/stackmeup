<Window x:Class="StackMeUp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="StackMeUp Ayarları" Icon="/assets/StackMeUp.ico"
        Width="800" Height="640" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource B.Window}" Foreground="{DynamicResource B.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <sys:Int32 x:Key="H6">6</sys:Int32>
        <sys:Int32 x:Key="H12">12</sys:Int32>
        <sys:Int32 x:Key="H24">24</sys:Int32>
        <sys:Int32 x:Key="H72">72</sys:Int32>
        <sys:Int32 x:Key="H168">168</sys:Int32>

        <!-- ============ Yazı stilleri ============ -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource B.SubText}"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource B.SubText}"/>
            <Setter Property="Margin" Value="4,20,0,8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource B.SubText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource B.SubText}"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Kart ve ayırıcı ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource B.Border}"/>
            <Setter Property="Margin" Value="0,12"/>
        </Style>

        <!-- ============ Aç/kapa anahtarı (CheckBox) ============ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Border x:Name="Track" Grid.Column="1" Width="42" Height="22" CornerRadius="11" VerticalAlignment="Center"
                                    Background="{DynamicResource B.Track}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Margin="4,0,0,0" HorizontalAlignment="Left"
                                         Fill="{DynamicResource B.SubText}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource B.Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Segmentli seçim (RadioButton) ============ -->
        <Style x:Key="Segmented" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="16,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Kaydırıcı ============ -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource B.Accent}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource B.Track}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18" Fill="White" Stroke="{DynamicResource B.Accent}" StrokeThickness="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Düğmeler ============ -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            <Setter Property="Background" Value="{DynamicResource B.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource B.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Metin kutusu ============ -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource B.Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource B.Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{DynamicResource B.Control}" BorderBrush="{DynamicResource B.Border}"
                                BorderThickness="1" CornerRadius="8" Padding="8,6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Açılır liste ============ -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{DynamicResource B.Control}" BorderBrush="{DynamicResource B.Border}"
                                                BorderThickness="1" CornerRadius="8">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,12,0"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource B.SubText}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,7,32,7" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Liste ============ -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,8" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{DynamicResource B.Control}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                                CornerRadius="8" Padding="4">
                            <ScrollViewer Focusable="False"><ItemsPresenter/></ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ İnce kaydırma çubuğu ============ -->
        <Style TargetType="ScrollBar">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border CornerRadius="3" Margin="3,2" Background="{DynamicResource B.Track}"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Sol menü (TabControl / TabItem) ============ -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="10,2">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource B.Accent}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Control}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <!-- Kenar çubuğu -->
                            <Border Background="{DynamicResource B.Sidebar}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,0,18">
                                        <Image Source="/assets/StackMeUp.ico" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="StackMeUp" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="Masaüstü yığınları" FontSize="11.5" Foreground="{DynamicResource B.SubText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Margin="22,0,16,18" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource B.SubText}"
                                               Text="Değişiklikler anında uygulanır ve kaydedilir."/>
                                    <StackPanel IsItemsHost="True"/>
                                </DockPanel>
                            </Border>
                            <!-- İçerik -->
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sayfa kaydırma alanı -->
        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="28,24,22,28"/>
        </Style>
    </Window.Resources>

    <TabControl>
        <!-- ================= GÖRÜNÜM ================= -->
        <TabItem Header="Görünüm" Tag="&#xE790;">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Görünüm"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="Yığınların ve bu pencerenin nasıl görüneceği."/>

                    <TextBlock Style="{StaticResource Section}" Text="TEMA"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Tema"/>
                                <Border Style="{StaticResource Segmented}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="Theme" Content="Sistem" IsChecked="{Binding IsThemeSystem}"/>
                                        <RadioButton GroupName="Theme" Content="Koyu" IsChecked="{Binding IsThemeDark}"/>
                                        <RadioButton GroupName="Theme" Content="Açık" IsChecked="{Binding IsThemeLight}"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Sistem: Windows açık/koyu moda geçince StackMeUp da geçer."/>

                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Arka plan rengi" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="BgSwatches"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Bu pencerenin ve yığınların zemini. İlk seçenek temanın kendi rengidir; yazılar seçtiğin renge göre otomatik açık ya da koyu olur."/>

                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Vurgu rengi" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="Swatches"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Section}" Text="DÜZEN VE BOYUT"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Yığınların dizilişi"/>
                                <Border Style="{StaticResource Segmented}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="Layout" Content="Yatay" IsChecked="{Binding IsHorizontal}"/>
                                        <RadioButton GroupName="Layout" Content="Dikey" IsChecked="{Binding IsVertical}"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Yatayda içerik aşağı, dikeyde yana açılır."/>

                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding IconSize, StringFormat={}{0:0} px}"/>
                                <TextBlock Style="{StaticResource Label}" Text="Yığın simgesi"/>
                            </DockPanel>
                            <Slider Minimum="32" Maximum="80" TickFrequency="4" IsSnapToTickEnabled="True" Value="{Binding IconSize}" Margin="0,6,0,0"/>

                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding ItemSize, StringFormat={}{0:0} px}"/>
                                <TextBlock Style="{StaticResource Label}" Text="Açılan dosyalar"/>
                            </DockPanel>
                            <Slider Minimum="20" Maximum="64" TickFrequency="4" IsSnapToTickEnabled="True" Value="{Binding ItemSize}" Margin="0,6,0,0"/>

                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}"/>
                                <TextBlock Style="{StaticResource Label}" Text="Başlık yoğunluğu"/>
                            </DockPanel>
                            <Slider Minimum="0.15" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding BackgroundOpacity}" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Yığın başlıklarının ne kadar saydam olacağı. Açılan panel her zaman okunacak kadar dolu kalır."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Section}" Text="YIĞIN KAPAĞI"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="İlk üç dosyayı yelpaze gibi göster" IsChecked="{Binding FanPreview}"/>
                            <CheckBox Content="Dosya sayısı rozetini göster" IsChecked="{Binding ShowCount}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= DAVRANIŞ ================= -->
        <TabItem Header="Davranış" Tag="&#xE713;">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Davranış"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="Konum, sıralama ve açılıp kapanma."/>

                    <TextBlock Style="{StaticResource Section}" Text="KONUM"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Konumu kilitle" IsChecked="{Binding LockPosition}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Kilit kapalıyken bir yığını tutup sürükleyerek paneli ekranda (ikinci monitör dahil) istediğin yere taşıyabilirsin."/>
                            <Button Content="Sağ üst köşeye al" Click="ResetPosition_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Section}" Text="SIRALAMA"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Width="230" SelectedIndex="{Binding SortIndex}">
                                <ComboBoxItem Content="En yeni önce"/>
                                <ComboBoxItem Content="Ada göre (A → Z)"/>
                                <ComboBoxItem Content="Boyuta göre (büyük önce)"/>
                                <ComboBoxItem Content="Türe göre (uzantı)"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource Label}" Text="Yığın içindeki sıra"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Section}" Text="AÇMA VE KAPAMA"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Masaüstüne ya da başka bir pencereye tıklayınca yığınları kapat" IsChecked="{Binding CloseOnDesktopClick}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Esc açık yığını kapatır. Bir dosyanın üstündeyken Boşluk onu açmadan önizler (QuickLook ile)."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Section}" Text="SON EKLENENLER"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Yeni gelen dosyaları en başta ayrı bir yığında da göster" IsChecked="{Binding ShowRecent}"/>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel IsEnabled="{Binding ShowRecent}">
                                <ComboBox DockPanel.Dock="Right" Width="230" SelectedValuePath="Tag" SelectedValue="{Binding RecentHours}">
                                    <ComboBoxItem Content="Son 6 saat" Tag="{StaticResource H6}"/>
                                    <ComboBoxItem Content="Son 12 saat" Tag="{StaticResource H12}"/>
                                    <ComboBoxItem Content="Son 1 gün" Tag="{StaticResource H24}"/>
                                    <ComboBoxItem Content="Son 3 gün" Tag="{StaticResource H72}"/>
                                    <ComboBoxItem Content="Son 1 hafta" Tag="{StaticResource H168}"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource Label}" Text="Ne kadar yeni olanlar"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Section}" Text="SİSTEM"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Windows'un kendi masaüstü simgelerini gizle" IsChecked="{Binding HideDesktopIcons}"/>
                            <CheckBox x:Name="AutoStartBox" Content="Windows ile birlikte başlat" Click="AutoStart_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= YIĞINLAR ================= -->
        <TabItem Header="Yığınlar" Tag="&#xE8F1;">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Yığınlar"/>
                    <TextBlock Style="{StaticResource PageSub}" Text="Hangi yığınların panelde görüneceği. Kapattıkların yalnızca gizlenir, dosyalar silinmez."/>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <UniformGrid x:Name="CategoriesPanel" Columns="2"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ================= KURALLAR ================= -->
        <TabItem Header="Kurallar" Tag="&#xE71C;">
            <DockPanel Margin="28,24,28,28">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Kurallar"/>
                    <TextBlock Style="{StaticResource PageSub}"
                               Text="Kendi yığınlarını tanımla. Virgülle ayır: nokta ile başlayanlar uzantıdır (.aep, .prproj), diğerleri dosya adında aranır (fatura, ekran görüntüsü). Üstteki kural önce uygulanır."/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Label}" Text="Yığın adı" Width="100"/>
                            <TextBox x:Name="RuleName"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Label}" Text="Eşleşenler" Width="100"/>
                            <TextBox x:Name="RuleMatch"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Primary}" Content="Ekle" Click="AddRule_Click"/>
                            <Button Content="Güncelle" Click="UpdateRule_Click"/>
                            <Button Content="Sil" Click="RemoveRule_Click"/>
                            <Button Content="Yukarı taşı" Click="MoveRuleUp_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <ListBox x:Name="RulesList" Margin="0,16,0,0" SelectionChanged="RulesList_SelectionChanged"/>
            </DockPanel>
        </TabItem>

        <!-- ================= KLASÖRLER ================= -->
        <TabItem Header="Klasörler" Tag="&#xE8B7;">
            <DockPanel Margin="28,24,28,28">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Klasörler"/>
                    <TextBlock Style="{StaticResource PageSub}"
                               Text="Masaüstü her zaman dahildir. Buraya eklediğin klasörlerdeki dosyalar da türlerine göre aynı yığınlara katılır."/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource Primary}" Content="Klasör ekle…" Click="AddFolder_Click"/>
                    <Button Content="İndirilenler'i ekle" Click="AddDownloads_Click"/>
                    <Button Content="Kaldır" Click="RemoveFolder_Click"/>
                </StackPanel>
                <ListBox x:Name="FoldersList" Margin="0,16,0,0"/>
            </DockPanel>
        </TabItem>
        <!-- ================= HAKKINDA ================= -->
        <TabItem Header="Hakkında" Tag="&#xE946;">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/assets/StackMeUp.ico" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource PageTitle}" Text="StackMeUp"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource PageSub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Section}" Text="GÜNCELLEMELER"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Yeni sürümleri otomatik denetle" IsChecked="{Binding CheckUpdates}"/>
                            <CheckBox Content="Yeni sürüm bulununca kendiliğinden kur" IsChecked="{Binding AutoInstallUpdates}"
                                      IsEnabled="{Binding CheckUpdates}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Kurulum birkaç saniye sürer: uygulama yeni sürümle kendiliğinden yeniden açılır, ayarların korunur."/>
                            <Border Style="{StaticResource Divider}"/>
                            <DockPanel>
                                <Button x:Name="CheckNowButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Margin="0"
                                        Content="Şimdi denetle" Click="CheckNow_Click"/>
                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource Label}" Foreground="{DynamicResource B.SubText}"
                                           TextWrapping="Wrap" Text="Son sürümü GitHub'dan denetler."/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Section}" Text="PROJE"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="0" Content="GitHub'da aç" Click="OpenRepo_Click"/>
                            <TextBlock Style="{StaticResource Label}" Text="Kaynak kod, sürümler ve indirme sayfası"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</Window>
