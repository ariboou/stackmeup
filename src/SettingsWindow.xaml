<Window x:Class="StackMeUp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="StackMeUp Ayarları" Icon="/assets/StackMeUp.ico" Width="560" Height="600" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="#F4F5F7" UseLayoutRounding="True">
    <Window.Resources>
        <sys:Int32 x:Key="H6">6</sys:Int32>
        <sys:Int32 x:Key="H12">12</sys:Int32>
        <sys:Int32 x:Key="H24">24</sys:Int32>
        <sys:Int32 x:Key="H72">72</sys:Int32>
        <sys:Int32 x:Key="H168">168</sys:Int32>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
            <Setter Property="Foreground" Value="#1F2328"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,2,16,14"/>
            <Setter Property="BorderBrush" Value="#E3E5E8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Text="Değişiklikler anında uygulanır ve kaydedilir."/>
            <Button DockPanel.Dock="Right" Content="Kapat" IsCancel="True" Margin="0" Click="Close_Click"/>
        </DockPanel>

        <TabControl Padding="0" Background="Transparent" BorderThickness="0">
            <!-- ================= GÖRÜNÜM ================= -->
            <TabItem Header="  Görünüm  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Section}" Text="Düzen"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Yatay (soldan sağa)" IsChecked="{Binding IsHorizontal}"/>
                                <RadioButton Content="Dikey (alt alta)" IsChecked="{Binding IsVertical}"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Section}" Text="Yığın simgesi boyutu"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" Text="{Binding IconSize, StringFormat={}{0:0} px}"/>
                                <Slider Minimum="32" Maximum="80" TickFrequency="4" IsSnapToTickEnabled="True" Value="{Binding IconSize}"/>
                            </DockPanel>

                            <TextBlock Style="{StaticResource Section}" Text="Açılan dosyaların boyutu"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" Text="{Binding ItemSize, StringFormat={}{0:0} px}"/>
                                <Slider Minimum="20" Maximum="64" TickFrequency="4" IsSnapToTickEnabled="True" Value="{Binding ItemSize}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Bir yığına tıklayınca açılan listedeki simgelerin ve yazıların boyutu."/>

                            <TextBlock Style="{StaticResource Section}" Text="Tema"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Sistem (Windows'a uy)" IsChecked="{Binding IsThemeSystem}"/>
                                <RadioButton Content="Koyu" IsChecked="{Binding IsThemeDark}"/>
                                <RadioButton Content="Açık" IsChecked="{Binding IsThemeLight}"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Section}" Text="Arka plan rengi"/>
                            <WrapPanel x:Name="BgSwatches"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="İlk seçenek temanın kendi rengidir. Yazı rengi, seçtiğin zemine göre otomatik açık ya da koyu olur."/>

                            <TextBlock Style="{StaticResource Section}" Text="Arka plan yoğunluğu"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}"/>
                                <Slider Minimum="0.15" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding BackgroundOpacity}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Yığın başlıklarının ne kadar saydam olacağı. Açılan panel her zaman okunacak kadar dolu kalır."/>

                            <TextBlock Style="{StaticResource Section}" Text="Vurgu rengi"/>
                            <WrapPanel x:Name="Swatches"/>

                            <TextBlock Style="{StaticResource Section}" Text="Yığın kapağı"/>
                            <CheckBox Content="İlk üç dosyayı yelpaze gibi göster" IsChecked="{Binding FanPreview}"/>
                            <CheckBox Content="Dosya sayısı rozetini göster" IsChecked="{Binding ShowCount}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ================= DAVRANIŞ ================= -->
            <TabItem Header="  Davranış  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Section}" Text="Konum"/>
                            <CheckBox Content="Konumu kilitle" IsChecked="{Binding LockPosition}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Kilit kapalıyken herhangi bir yığını tutup sürükleyerek paneli ekranda (ikinci monitör dahil) istediğin yere taşıyabilirsin."/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Sağ üst köşeye al" Click="ResetPosition_Click"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Section}" Text="Sıralama"/>
                            <ComboBox Width="220" HorizontalAlignment="Left" SelectedIndex="{Binding SortIndex}">
                                <ComboBoxItem Content="En yeni önce"/>
                                <ComboBoxItem Content="Ada göre (A → Z)"/>
                                <ComboBoxItem Content="Boyuta göre (büyük önce)"/>
                                <ComboBoxItem Content="Türe göre (uzantı)"/>
                            </ComboBox>

                            <TextBlock Style="{StaticResource Section}" Text="Açma / kapama"/>
                            <CheckBox Content="Masaüstüne ya da başka bir pencereye tıklayınca yığınları kapat" IsChecked="{Binding CloseOnDesktopClick}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Esc tuşu da açık yığını kapatır. Bir dosyanın üstündeyken Boşluk tuşu onu açmadan önizler (QuickLook ile)."/>

                            <TextBlock Style="{StaticResource Section}" Text="Son eklenenler"/>
                            <CheckBox Content="Yeni gelen dosyaları en başta ayrı bir yığında da göster" IsChecked="{Binding ShowRecent}"/>
                            <StackPanel Orientation="Horizontal" Margin="22,4,0,0">
                                <TextBlock Text="Şu kadar yeni olanlar:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="120" SelectedValuePath="Tag" SelectedValue="{Binding RecentHours}" IsEnabled="{Binding ShowRecent}">
                                    <ComboBoxItem Content="Son 6 saat" Tag="{StaticResource H6}"/>
                                    <ComboBoxItem Content="Son 12 saat" Tag="{StaticResource H12}"/>
                                    <ComboBoxItem Content="Son 1 gün" Tag="{StaticResource H24}"/>
                                    <ComboBoxItem Content="Son 3 gün" Tag="{StaticResource H72}"/>
                                    <ComboBoxItem Content="Son 1 hafta" Tag="{StaticResource H168}"/>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Section}" Text="Sistem"/>
                            <CheckBox Content="Windows'un masaüstü simgelerini gizle" IsChecked="{Binding HideDesktopIcons}"/>
                            <CheckBox x:Name="AutoStartBox" Content="Windows ile birlikte başlat" Click="AutoStart_Click"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ================= YIĞINLAR ================= -->
            <TabItem Header="  Yığınlar  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Section}" Text="Gösterilecek yığınlar"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="İşaretini kaldırdığın türler panelde görünmez. Dosyalar silinmez, yalnızca gizlenir."/>
                            <UniformGrid x:Name="CategoriesPanel" Columns="2"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ================= KURALLAR ================= -->
            <TabItem Header="  Kurallar  ">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource Section}" Text="Kendi yığınların"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="Eşleşen dosyalar hazır türlere girmeden önce bu yığınlara gider. Virgülle ayır: nokta ile başlayanlar uzantıdır (.aep, .prproj), diğerleri dosya adında aranır (fatura, ekran görüntüsü). Üstteki kural önce uygulanır."/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Yığın adı" Width="110" VerticalAlignment="Center"/>
                                <TextBox x:Name="RuleName" Padding="4,3"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Eşleşenler" Width="110" VerticalAlignment="Center"/>
                                <TextBox x:Name="RuleMatch" Padding="4,3"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Ekle" Click="AddRule_Click"/>
                                <Button Content="Güncelle" Click="UpdateRule_Click"/>
                                <Button Content="Sil" Click="RemoveRule_Click"/>
                                <Button Content="Yukarı" Click="MoveRuleUp_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <ListBox x:Name="RulesList" MinHeight="120" SelectionChanged="RulesList_SelectionChanged"/>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ================= KLASÖRLER ================= -->
            <TabItem Header="  Klasörler  ">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource Section}" Text="Ek klasörler"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="Masaüstü her zaman dahildir. Buraya eklediğin klasörlerdeki dosyalar da türlerine göre aynı yığınlara katılır."/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Klasör ekle…" Click="AddFolder_Click"/>
                            <Button Content="İndirilenler'i ekle" Click="AddDownloads_Click"/>
                            <Button Content="Kaldır" Click="RemoveFolder_Click"/>
                        </StackPanel>
                        <ListBox x:Name="FoldersList" MinHeight="160"/>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
